# Versión 2.0 — añade header X-PulseBoard-Version en todas las respuestas
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

FROM base AS builder
COPY servicios/ingest-api/requirements.txt .
RUN pip install --prefix=/install --no-cache-dir -r requirements.txt

FROM base AS final
ARG BUILD_DATE
ARG VERSION=2.0
LABEL org.opencontainers.image.title="pulseboard-ingest-api" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

ENV API_VERSION=2.0

COPY --from=builder /install /usr/local
RUN useradd --no-create-home --shell /sbin/nologin appuser
COPY infra/dockerfiles/ingest-api/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
COPY servicios/ingest-api/ .
USER appuser
EXPOSE 5000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')"]
ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "wsgi:app"]
